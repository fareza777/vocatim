<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ variant of backup_rules.xml: same allowlist for cloud backup and
     device-to-device transfer. Settings only — transcripts, the BYOK API key,
     the entitlement, and the media dirs never leave the device this way. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/vocatim_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/vocatim_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
