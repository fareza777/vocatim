<?xml version="1.0" encoding="utf-8"?>
<!-- Allowlist, not a denylist: anything not named here stays on the device.
     That keeps the promise in PRIVACY_POLICY.md ("never leave your phone
     unless you explicitly share, export, or back them up yourself") true for
     transcripts (vocatim.db), the BYOK API key and the purchase entitlement
     (vocatim_secrets), and the heavyweight media dirs. Settings are the only
     thing worth restoring automatically, and they carry no personal data.

     Transcripts still have a migration path: Settings -> encrypted backup. -->
<full-backup-content>
    <include domain="file" path="datastore/vocatim_prefs.preferences_pb" />
</full-backup-content>
