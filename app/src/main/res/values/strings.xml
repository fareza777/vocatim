    <string name="onboarding_privacy_title">Voice to text, your way</string>
    <string name="onboarding_privacy_body">Vocatim turns recordings into text. You choose where that happens — on this phone, or on a fast server. Either way, you can switch later.</string>
    <string name="onboarding_mode_title">Where should transcription run?</string>
    <string name="onboarding_mode_body">Both work well. Pick what matters more to you today.</string>
    <string name="onboarding_mode_offline">On this phone</string>
    <string name="onboarding_mode_offline_desc">Nothing is uploaded, works with no internet. Needs a one-time model download, and long recordings take a while on older phones.</string>
    <string name="onboarding_mode_online">In the cloud</string>
    <string name="onboarding_mode_online_desc">An hour of audio in seconds, and more accurate. Needs internet and a free API key — we walk you through it next.</string>
    <string name="onboarding_online_title">Connect your key</string>
    <string name="onboarding_online_body">Vocatim uses your own free account, so your audio goes straight to the provider and never through us.</string>
    <string name="onboarding_online_step1">1. Tap “Get a free key” — no credit card needed.</string>
    <string name="onboarding_online_step2">2. Sign in, create a key, copy it.</string>
    <string name="onboarding_online_step3">3. Paste it below.</string>
    <string name="onboarding_online_ready">Key saved — you’re all set!</string>
